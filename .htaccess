<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Don't rewrite existing files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rewrite URLs to add .php extension
    RewriteRule ^([a-zA-Z0-9-]+)/?$ $1.php [L]
</IfModule>
